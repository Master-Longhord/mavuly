// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  TESTER
  DEVELOPER
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  STARTED
  SUBMITTED
  APPROVED
  REJECTED
  DISPUTED
}

enum EscrowTxType {
  DEPOSIT
  ALLOCATION
  REFUND
  RELEASE
}

enum EscrowTxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  REWARD
  PVP_WIN
  PVP_ENTRY
  WITHDRAWAL
  PLATFORM_PROFIT
  REFERRAL_BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum GameType {
  WORD_CLASH
  DICE_DASH
  MATH_DUEL
  TRIVIA_RUSH
  TILE_MATCH
  SNOOKER
  WHOT
  UNO
  SPIDER
  LUDO
  MONOPOLY
}

enum MatchStatus {
  WAITING_OPPONENT
  PLAYING
  SETTLED
  EXPIRED_REFUNDED
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FLAGGED
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  passwordHash       String           @map("password_hash")
  resetToken         String?          @map("reset_token")
  resetTokenExpires  DateTime?        @map("reset_token_expires")
  role               Role             @default(USER)
  accountType        AccountType      @default(TESTER) @map("account_type")
  name               String?          // Used for Tester Name
  studioName         String?          @map("studio_name") // Used for Developer Studio Name
  phone              String?
  country            String?
  dob                DateTime?        // Date of Birth
  notifications      Boolean          @default(true)
  legalName          String?          @map("legal_name")
  bankName           String?          @map("bank_name")
  accountNumber      String?          @map("account_number")
  accountName        String?          @map("account_name")
  withdrawalVerified Boolean          @default(false) @map("withdrawal_verified")
  isEmailVerified    Boolean          @default(false) @map("is_email_verified")
  emailVerifyToken   String?          @map("email_verify_token")
  referralCode       String?          @unique @map("referral_code")
  referredById       String?          @map("referred_by_id")

  kycStatus          KycStatus        @default(UNVERIFIED) @map("kyc_status")
  bankAccount        BankAccount?

  developerVerified  Boolean          @default(false) @map("developer_verified")
  coinBalance        Int              @default(0) @map("coin_balance")
  escrowBalance      Decimal          @default(0.00) @db.Decimal(12, 2) @map("escrow_balance")
  isActive           Boolean          @default(true) @map("is_active")
  
  tamperAttemptCount Int              @default(0) @map("tamper_attempt_count")
  
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  // --- DEVELOPER KYB & API SETTINGS ---
  businessDocUrl     String?          @map("business_doc_url")
  idDocUrl           String?          @map("id_doc_url")
  addressDocUrl      String?          @map("address_doc_url")
  apiKey             String?          @unique @map("api_key")
  apiSecret          String?          @map("api_secret")
  postbackUrl        String?          @map("postback_url")
  
  apps               DeveloperApp[]   @relation("DeveloperApps")

  lastDailyClaim     DateTime?        @map("last_daily_claim")

  refreshTokens      RefreshToken[]
  campaigns          Campaign[]       @relation("DeveloperCampaigns")
  submissions        TaskSubmission[] @relation("TesterSubmissions")
  escrowTransactions EscrowTransaction[]
  transactions       Transaction[]
  hostedMatches      MultiplayerMatch[] @relation("MatchHost")
  wonMultiMatches    MultiplayerMatch[] @relation("MultiplayerWinner")
  matchParticipations MatchParticipant[] @relation("UserMatchParticipations")

  referredBy         User?            @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]           @relation("UserReferrals")
  tickets            Ticket[]
  userNotifications  Notification[]

  dailyAdRefillsCount Int              @default(0) @map("daily_ad_refills_count")
  lastAdRefillAt     DateTime?        @map("last_ad_refill_at")
  
  matchesAsPlayer1   ArcadeMatch[]    @relation("MatchPlayer1")
  matchesAsPlayer2   ArcadeMatch[]    @relation("MatchPlayer2")
  matchesWon         ArcadeMatch[]    @relation("MatchWinner")

  streakDays         Int              @default(0) @map("streak_days")
  lastStreakDate     String?          @map("last_streak_date") // Stored as "YYYY-MM-DD"
  matchesPlayedToday Int              @default(0) @map("matches_played_today")
  mathMatchesToday   Int              @default(0) @map("math_matches_today")
  tileMatchesToday   Int              @default(0) @map("tile_matches_today")
  questClaimsDate    String?          @map("quest_claims_date") // Stored as "YYYY-MM-DD"
  questClaims        String[]         @default([]) @map("quest_claims")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Campaign {
  id                 String           @id @default(uuid())
  developerId        String           @map("developer_id")
  title              String
  appName            String           @map("app_name")
  targetUrl          String           @map("target_url")
  category           String
  instructions       String[]         //Ordered step-by-step instructions
  requirements       Json             //OS, device type, minimum RAM, country
  estimatedMinutes   Int              @default(15) @map("estimated_minutes")
  difficulty         String           @default("Easy")
  targetTesters      Int              @map("target_testers")
  completedTesters   Int              @default(0) @map("completed_testers")
  rewardPerTask      Decimal          @db.Decimal(10, 2) @map("reward_per_task")
  totalBudget        Decimal          @db.Decimal(12, 2) @map("total_budget")
  budgetRemaining    Decimal          @db.Decimal(12, 2) @map("budget_remaining")
  platformFeePercent Decimal          @default(0.10) @db.Decimal(4, 2) @map("platform_fee_percent")
  status             CampaignStatus   @default(ACTIVE)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  productType        String           @default("App") @map("product_type")
  platforms          String[]         @default(["Android"])
  description        String?          @db.Text
  version            String?
  deadline           DateTime?

  developer          User             @relation("DeveloperCampaigns", fields: [developerId], references: [id])
  submissions        TaskSubmission[]

  @@map("campaigns")
}

model TaskSubmission {
  id                 String           @id @default(uuid())
  campaignId         String           @map("campaign_id")
  testerId           String           @map("tester_id")
  status             SubmissionStatus @default(STARTED)
  verificationStatus String?          @map("verification_status")
  rejectionReason    String?          @map("rejection_reason")
  startedAt          DateTime         @default(now()) @map("started_at")
  submittedAt        DateTime?        @map("submitted_at")
  verifiedAt         DateTime?        @map("verified_at")

  campaign           Campaign         @relation(fields: [campaignId], references: [id])
  tester             User             @relation("TesterSubmissions", fields: [testerId], references: [id])
  feedback           Feedback?
  transaction        Transaction?

  @@unique([campaignId, testerId])
  @@map("task_submissions")
}

model Feedback {
  id                 String         @id @default(uuid())
  submissionId       String         @unique @map("submission_id")
  rating             Int
  liked              String?        @db.Text
  disliked           String?        @db.Text
  foundBug           Boolean        @default(false) @map("found_bug")
  bugDescription     String?        @db.Text @map("bug_description")
  stepsToReproduce   String?        @db.Text @map("steps_to_reproduce")
  screenshotUrl      String         @map("screenshot_url")
  deviceInfo         Json           @map("device_info")
  bugSeverity        String?          @map("bug_severity")
bugStatus          String           @default("OPEN") @map("bug_status")
  comments           String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")

  submission         TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model EscrowTransaction {
  id              String         @id @default(uuid())
  developerId     String         @map("developer_id")
  campaignId      String?        @map("campaign_id")
  amount          Decimal        @db.Decimal(12, 2)
  type            EscrowTxType
  status          EscrowTxStatus @default(COMPLETED)
  reference       String         @unique
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")

  developer       User           @relation(fields: [developerId], references: [id])

  @@map("escrow_transactions")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  submissionId    String?           @unique @map("submission_id")
  amount          Decimal           @db.Decimal(12, 2)
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  reference       String            @unique
  description     String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id])
  submission      TaskSubmission?   @relation(fields: [submissionId], references: [id])

  @@map("transactions")
}

model ArcadeMatch {
  id                 String      @id @default(uuid())
  gameType           GameType    @map("game_type")
  stakeAmount        Int         @default(50) @map("stake_amount") // Cost to play
  prizeAmount        Int         @default(85) @map("prize_amount") // Winner takes
  boardSeed          String      @map("board_seed") // Anti-cheat seed
  
  player1Id          String      @map("player1_id")
  player2Id          String?     @map("player2_id")
  
  player1Score       Int?        @map("player1_score")
  player2Score       Int?        @map("player2_score")
  
  player1CompletedAt DateTime?   @map("player1_completed_at")
  player2CompletedAt DateTime?   @map("player2_completed_at")
  
  winnerId           String?     @map("winner_id")
  status             MatchStatus @default(WAITING_OPPONENT)
  
  isBotOpponent      Boolean     @default(false) @map("is_bot_opponent")
  botName            String?     @map("bot_name")
  
  settledAt          DateTime?   @map("settled_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  player1            User        @relation("MatchPlayer1", fields: [player1Id], references: [id])
  player2            User?       @relation("MatchPlayer2", fields: [player2Id], references: [id])
  winner             User?       @relation("MatchWinner", fields: [winnerId], references: [id])

  @@map("arcade_matches")
}

model BankAccount {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  bankCode      String    @map("bank_code")
  bankName      String    @map("bank_name")
  accountNumber String    @map("account_number")
  accountName   String    @map("account_name")
  isVerified    Boolean   @default(false) @map("is_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Critical: Prevents multi-account reward farming
  @@unique([bankCode, accountNumber], name: "unique_bank_destination")
  @@map("bank_accounts")
}

model Ticket {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  subject     String
  category    String
  description String   @db.Text
  status      String   @default("OPEN")
  adminReply  String?  @db.Text @map("admin_reply")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  user        User     @relation(fields: [userId], references: [id])
  @@map("tickets")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notifications")
}

model DeveloperApp {
  id               String   @id @default(uuid())
  developerId      String   @map("developer_id")
  name             String
  type             String   @default("App")
  version          String?
  description      String?  @db.Text
  moderationStatus String   @default("PENDING") @map("moderation_status") // PENDING, APPROVED, REJECTED
  moderationNotes  String?  @db.Text @map("moderation_notes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  developer        User     @relation("DeveloperApps", fields: [developerId], references: [id], onDelete: Cascade)

  @@map("developer_apps")
}

model MultiplayerMatch {
  id            String        @id @default(uuid())
  roomCode      String        @unique @map("room_code")
  gameType      GameType      @map("game_type")
  stakeAmount   Int           @default(50) @map("stake_amount")
  prizePool     Int           @default(0)  @map("prize_pool") // Grows as players join
  maxPlayers    Int           @default(4)  @map("max_players") // 2, 3, or 4 players
  status        MatchStatus   @default(WAITING_OPPONENT)
  
  hostId        String        @map("host_id") // The person who created the room
  winnerId      String?       @map("winner_id")
  
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  host          User          @relation("MatchHost", fields: [hostId], references: [id])
  winner        User?         @relation("MultiplayerWinner", fields: [winnerId], references: [id])
  participants  MatchParticipant[]

  @@map("multiplayer_matches")
}

model MatchParticipant {
  id                 String           @id @default(uuid())
  matchId            String           @map("match_id")
  userId             String           @map("user_id")
  
  score              Int?             // For Whot, could be remaining card count (0 = winner)
  completedAt        DateTime?        @map("completed_at")
  joinedAt           DateTime         @default(now()) @map("joined_at")

  match              MultiplayerMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user               User             @relation("UserMatchParticipations", fields: [userId], references: [id])

  @@unique([matchId, userId]) // Prevents a user from joining the same room twice
  @@map("match_participants")
}