// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  TESTER
  DEVELOPER
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  STARTED
  SUBMITTED
  APPROVED
  REJECTED
  DISPUTED
}

enum EscrowTxType {
  DEPOSIT
  ALLOCATION
  REFUND
  RELEASE
}

enum EscrowTxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  REWARD
  PVP_WIN
  PVP_ENTRY
  WITHDRAWAL
  PLATFORM_PROFIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum GameType {
  WORD_CLASH
  DICE_DASH
  MATH_DUEL
  TRIVIA_RUSH
  TILE_MATCH
}

enum MatchStatus {
  WAITING_OPPONENT
  PLAYING
  SETTLED
  EXPIRED_REFUNDED
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FLAGGED
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  passwordHash       String           @map("password_hash")
  role               Role             @default(USER)
  accountType        AccountType      @default(TESTER) @map("account_type")
  name               String?          // Used for Tester Name
  studioName         String?          @map("studio_name") // Used for Developer Studio Name
  phone              String?
  country            String?
  dob                DateTime?        // Date of Birth
  notifications      Boolean          @default(true)
  legalName          String?          @map("legal_name")
  bankName           String?          @map("bank_name")
  accountNumber      String?          @map("account_number")
  accountName        String?          @map("account_name")
  withdrawalVerified Boolean          @default(false) @map("withdrawal_verified")

  kycStatus          KycStatus        @default(UNVERIFIED) @map("kyc_status")
  bankAccount        BankAccount?

  developerVerified  Boolean          @default(false) @map("developer_verified")
  coinBalance        Int              @default(0) @map("coin_balance")
  escrowBalance      Decimal          @default(0.00) @db.Decimal(12, 2) @map("escrow_balance")
  isActive           Boolean          @default(true) @map("is_active")
  
  tamperAttemptCount Int              @default(0) @map("tamper_attempt_count")
  
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  lastDailyClaim     DateTime?        @map("last_daily_claim")

  refreshTokens      RefreshToken[]
  campaigns          Campaign[]       @relation("DeveloperCampaigns")
  submissions        TaskSubmission[] @relation("TesterSubmissions")
  escrowTransactions EscrowTransaction[]
  transactions       Transaction[]
  
  matchesAsPlayer1   ArcadeMatch[]    @relation("MatchPlayer1")
  matchesAsPlayer2   ArcadeMatch[]    @relation("MatchPlayer2")
  matchesWon         ArcadeMatch[]    @relation("MatchWinner")

  streakDays         Int              @default(0) @map("streak_days")
  lastStreakDate     String?          @map("last_streak_date") // Stored as "YYYY-MM-DD"
  matchesPlayedToday Int              @default(0) @map("matches_played_today")
  mathMatchesToday   Int              @default(0) @map("math_matches_today")
  tileMatchesToday   Int              @default(0) @map("tile_matches_today")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Campaign {
  id                 String           @id @default(uuid())
  developerId        String           @map("developer_id")
  title              String
  appName            String           @map("app_name")
  targetUrl          String           @map("target_url")
  category           String
  instructions       String[]         //Ordered step-by-step instructions
  requirements       Json             //OS, device type, minimum RAM, country
  estimatedMinutes   Int              @default(15) @map("estimated_minutes")
  difficulty         String           @default("Easy")
  targetTesters      Int              @map("target_testers")
  completedTesters   Int              @default(0) @map("completed_testers")
  rewardPerTask      Decimal          @db.Decimal(10, 2) @map("reward_per_task")
  totalBudget        Decimal          @db.Decimal(12, 2) @map("total_budget")
  budgetRemaining    Decimal          @db.Decimal(12, 2) @map("budget_remaining")
  platformFeePercent Decimal          @default(0.10) @db.Decimal(4, 2) @map("platform_fee_percent")
  status             CampaignStatus   @default(ACTIVE)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  developer          User             @relation("DeveloperCampaigns", fields: [developerId], references: [id])
  submissions        TaskSubmission[]

  @@map("campaigns")
}

model TaskSubmission {
  id                 String           @id @default(uuid())
  campaignId         String           @map("campaign_id")
  testerId           String           @map("tester_id")
  status             SubmissionStatus @default(STARTED)
  verificationStatus String?          @map("verification_status")
  rejectionReason    String?          @map("rejection_reason")
  startedAt          DateTime         @default(now()) @map("started_at")
  submittedAt        DateTime?        @map("submitted_at")
  verifiedAt         DateTime?        @map("verified_at")

  campaign           Campaign         @relation(fields: [campaignId], references: [id])
  tester             User             @relation("TesterSubmissions", fields: [testerId], references: [id])
  feedback           Feedback?
  transaction        Transaction?

  @@unique([campaignId, testerId])
  @@map("task_submissions")
}

model Feedback {
  id                 String         @id @default(uuid())
  submissionId       String         @unique @map("submission_id")
  rating             Int
  liked              String?        @db.Text
  disliked           String?        @db.Text
  foundBug           Boolean        @default(false) @map("found_bug")
  bugDescription     String?        @db.Text @map("bug_description")
  stepsToReproduce   String?        @db.Text @map("steps_to_reproduce")
  screenshotUrl      String         @map("screenshot_url")
  deviceInfo         Json           @map("device_info")
  comments           String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")

  submission         TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model EscrowTransaction {
  id              String         @id @default(uuid())
  developerId     String         @map("developer_id")
  campaignId      String?        @map("campaign_id")
  amount          Decimal        @db.Decimal(12, 2)
  type            EscrowTxType
  status          EscrowTxStatus @default(COMPLETED)
  reference       String         @unique
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")

  developer       User           @relation(fields: [developerId], references: [id])

  @@map("escrow_transactions")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  submissionId    String?           @unique @map("submission_id")
  amount          Decimal           @db.Decimal(12, 2)
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  reference       String            @unique
  description     String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id])
  submission      TaskSubmission?   @relation(fields: [submissionId], references: [id])

  @@map("transactions")
}

model ArcadeMatch {
  id                 String      @id @default(uuid())
  gameType           GameType    @map("game_type")
  stakeAmount        Int         @default(50) @map("stake_amount") // Cost to play
  prizeAmount        Int         @default(85) @map("prize_amount") // Winner takes
  boardSeed          String      @map("board_seed") // Anti-cheat seed
  
  player1Id          String      @map("player1_id")
  player2Id          String?     @map("player2_id")
  
  player1Score       Int?        @map("player1_score")
  player2Score       Int?        @map("player2_score")
  
  player1CompletedAt DateTime?   @map("player1_completed_at")
  player2CompletedAt DateTime?   @map("player2_completed_at")
  
  winnerId           String?     @map("winner_id")
  status             MatchStatus @default(WAITING_OPPONENT)
  
  isBotOpponent      Boolean     @default(false) @map("is_bot_opponent")
  botName            String?     @map("bot_name")
  
  settledAt          DateTime?   @map("settled_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  player1            User        @relation("MatchPlayer1", fields: [player1Id], references: [id])
  player2            User?       @relation("MatchPlayer2", fields: [player2Id], references: [id])
  winner             User?       @relation("MatchWinner", fields: [winnerId], references: [id])

  @@map("arcade_matches")
}

model BankAccount {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  bankCode      String    @map("bank_code")
  bankName      String    @map("bank_name")
  accountNumber String    @map("account_number")
  accountName   String    @map("account_name")
  isVerified    Boolean   @default(false) @map("is_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Critical: Prevents multi-account reward farming
  @@unique([bankCode, accountNumber], name: "unique_bank_destination")
  @@map("bank_accounts")
}